# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Configured securely in environment secrets (never exposed to frontend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# SUPABASE: Required for cloud PostgreSQL persistence and authentication.
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"
